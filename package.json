{
  "name": "naija-tax-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:generate",
    "predev:safe": "npm run db:generate",
    "dev": "node scripts/dev-safe.cjs",
    "dev:full": "node scripts/dev-full.cjs",
    "dev:safe": "lsof -ti :3000,3001 | xargs kill -9 2>/dev/null || true && rm -f .next/dev/lock && npm run dev",
    "build": "npm run db:generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:server": "tsx scripts/mcp-financial-server.ts",
    "pb:init": "tsx scripts/pocketbase-init.ts",
    "pb:repair:local": "tsx scripts/pocketbase-backfill-local-timestamps.ts",
    "pb:up": "docker compose -f docker-compose.pocketbase.yml up -d",
    "pb:up:local": "mkdir -p .pocketbase/pb_data .pocketbase/pb_public .pocketbase/pb_migrations && ./.tools/pocketbase/0.35.1/pocketbase --dir .pocketbase/pb_data --publicDir .pocketbase/pb_public --migrationsDir .pocketbase/pb_migrations serve --http 127.0.0.1:8090",
    "pb:down": "docker compose -f docker-compose.pocketbase.yml down",
    "pb:logs": "docker compose -f docker-compose.pocketbase.yml logs -f pocketbase",
    "pb:clean:legacy": "tsx scripts/pocketbase-clean-legacy.ts",
    "pb:oauth:google": "tsx scripts/pocketbase-configure-google-oauth.ts",
    "pb:auth:repair": "tsx scripts/pocketbase-repair-auth-oauth.ts",
    "prod:check": "tsx scripts/production-readiness.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 npx prisma generate --no-hints",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/dotenv": "^6.1.1",
    "@types/jspdf": "^1.3.3",
    "dotenv": "^17.2.3",
    "jspdf": "^4.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.4",
    "openai": "^6.16.0",
    "pdfkit": "^0.17.2",
    "pocketbase": "^0.26.8",
    "prisma": "^5.22.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.69.0",
    "recharts": "^3.6.0",
    "zod": "^4.3.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.15"
  }
}
