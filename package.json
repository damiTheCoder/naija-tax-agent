{
  "name": "naija-tax-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:generate && node scripts/clear-next-lock.cjs",
    "predev:safe": "npm run db:generate && node scripts/clear-next-lock.cjs",
    "dev": "node scripts/dev-safe.cjs",
    "dev:safe": "lsof -ti :3000,3001 | xargs kill -9 2>/dev/null || true && rm -f .next/dev/lock && npm run dev",
    "build": "npm run db:generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:server": "tsx scripts/mcp-financial-server.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/dotenv": "^6.1.1",
    "@types/jspdf": "^1.3.3",
    "dotenv": "^17.2.3",
    "jspdf": "^4.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.4",
    "openai": "^6.16.0",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.69.0",
    "recharts": "^3.6.0",
    "zod": "^4.3.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.15"
  }
}
