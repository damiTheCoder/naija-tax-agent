// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================================================
// INVENTORY INTELLIGENCE - Multi-Branch Inventory Management
// SQLite compatible (no enums - using String with defaults)
// ============================================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  locations      Location[]
  users          User[]
  suppliers      Supplier[]
  categories     Category[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  transfers      Transfer[]
  sales          Sale[]
  stockMovements StockMovement[]
  menuItems      MenuItem[]
  employees      Employee[]
  payrollRuns    PayrollRun[]
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  type      String   @default("BRANCH") // WAREHOUSE | BRANCH
  name      String
  address   String?
  createdAt DateTime @default(now())

  company            Company            @relation(fields: [companyId], references: [id])
  users              User[]
  inventoryBalances  InventoryBalance[]
  purchaseOrders     PurchaseOrder[]
  transfersFrom      Transfer[]         @relation("TransferFrom")
  transfersTo        Transfer[]         @relation("TransferTo")
  sales              Sale[]
  stockMovementsFrom StockMovement[]    @relation("MovementFrom")
  stockMovementsTo   StockMovement[]    @relation("MovementTo")
}

model User {
  id         String   @id @default(cuid())
  companyId  String
  locationId String?
  email      String   @unique
  name       String
  role       String   @default("STAFF") // OWNER | MANAGER | STAFF
  createdAt  DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  company        Company         @relation(fields: [companyId], references: [id])
  purchaseOrders PurchaseOrder[]
}

model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  companyId    String
  categoryId   String?
  sku          String   @unique
  name         String
  unit         String   @default("pcs")
  costPrice    Float    @default(0)
  sellingPrice Float    @default(0)
  reorderLevel Int      @default(10)
  trackExpiry  Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company            Company              @relation(fields: [companyId], references: [id])
  category           Category?            @relation(fields: [categoryId], references: [id])
  inventoryBalances  InventoryBalance[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  transferLines      TransferLine[]
  saleLines          SaleLine[]
  bomLines           BomLine[]
}

model InventoryBalance {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  onHand     Int      @default(0)
  reserved   Int      @default(0)
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
}

model StockMovement {
  id             String   @id @default(cuid())
  companyId      String
  productId      String
  fromLocationId String?
  toLocationId   String?
  type           String   // PURCHASE_RECEIPT | SALE | ADJUSTMENT | TRANSFER_OUT | TRANSFER_IN
  qty            Int
  unitCost       Float    @default(0)
  referenceType  String?
  referenceId    String?
  notes          String?
  createdAt      DateTime @default(now())

  company      Company   @relation(fields: [companyId], references: [id])
  product      Product   @relation(fields: [productId], references: [id])
  fromLocation Location? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("MovementTo", fields: [toLocationId], references: [id])
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  companyId  String
  supplierId String
  locationId String
  status     String   @default("DRAFT") // DRAFT | PENDING | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company             @relation(fields: [companyId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  location Location            @relation(fields: [locationId], references: [id])
  lines    PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String
  qtyOrdered      Int
  qtyReceived     Int    @default(0)
  unitCost        Float  @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

model Transfer {
  id             String   @id @default(cuid())
  companyId      String
  fromLocationId String
  toLocationId   String
  status         String   @default("CREATED") // CREATED | IN_TRANSIT | RECEIVED | CANCELLED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company        @relation(fields: [companyId], references: [id])
  fromLocation Location       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location       @relation("TransferTo", fields: [toLocationId], references: [id])
  lines        TransferLine[]
}

model TransferLine {
  id         String @id @default(cuid())
  transferId String
  productId  String
  qty        Int
  unitCost   Float  @default(0)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model Sale {
  id          String   @id @default(cuid())
  companyId   String
  locationId  String
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())

  company  Company    @relation(fields: [companyId], references: [id])
  location Location   @relation(fields: [locationId], references: [id])
  lines    SaleLine[]
}

model SaleLine {
  id         String  @id @default(cuid())
  saleId     String
  productId  String?
  menuItemId String?
  qty        Int
  unitPrice  Float   @default(0)
  unitCost   Float   @default(0)

  sale     Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id])
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id])
}

// Restaurant Mode (Optional BOM support)
model MenuItem {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  sellingPrice Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id])
  bomLines  BomLine[]
  saleLines SaleLine[]
}

model BomLine {
  id         String @id @default(cuid())
  menuItemId String
  productId  String
  qtyPerUnit Float  @default(1)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

// ============================================================================
// PAYROLL & COMPLIANCE - Employee & Monthly Payroll Management
// ============================================================================

model Employee {
  id              String   @id @default(cuid())
  companyId       String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  role            String   @default("STAFF")
  tin             String?  // Tax Identification Number
  pensionPin      String?  // Pension PIN
  nhfNumber       String?  // NHF Number
  bankName        String?
  accountNumber   String?
  basicSalary     Float    @default(0)
  housingAllowance Float   @default(0)
  transportAllowance Float @default(0)
  otherAllowances  Float   @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  payrollEntries PayrollEntry[]
}

model PayrollRun {
  id          String   @id @default(cuid())
  companyId   String
  month       Int      // 1-12
  year        Int
  status      String   @default("DRAFT") // DRAFT | APPROVED | PAID
  totalGross  Float    @default(0)
  totalNet    Float    @default(0)
  totalTax    Float    @default(0) // Total PAYE
  totalPension Float   @default(0)
  totalNHF    Float    @default(0)
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  payrollEntries PayrollEntry[]

  @@unique([companyId, month, year])
}

model PayrollEntry {
  id           String @id @default(cuid())
  payrollRunId String
  employeeId   String
  grossSalary  Float
  netSalary    Float
  taxAmount    Float  // PAYE
  pensionAmount Float
  nhfAmount    Float
  otherDeductions Float @default(0)
  notes        String?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])
}

// ============================================================================
// TAX COMPLIANCE ENGINE - Core Accounting + Tax Models
// SQLite compatible (no enums - using String with defaults)
// ============================================================================

model Entity {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  taxId     String?
  type      String   @default("BUSINESS") // BUSINESS | INDIVIDUAL
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company?              @relation(fields: [companyId], references: [id])
  transactions        Transaction[]
  invoices            Invoice[]
  bills               Bill[]
  payments            Payment[]
  vendors             Vendor[]
  customers           Customer[]
  chartOfAccounts     ChartOfAccount[]
  taxRuleSets         TaxRuleSet[]
  taxCategories       TaxCategory[]
  taxRules            TaxRule[]
  taxClassifications  TaxClassification[]
  taxLedgerEntries    TaxLedgerEntry[]
  taxPeriods          TaxPeriod[]
  taxSchedules        TaxSchedule[]
  complianceDeadlines ComplianceDeadline[]
  complianceStatuses  ComplianceStatus[]
  taxFilingPackages   TaxFilingPackage[]
  taxPayments         TaxPayment[]
  taxReconciliations  TaxReconciliation[]
  auditLogs           AuditLog[]
}

model Transaction {
  id          String   @id @default(cuid())
  entityId    String
  date        DateTime
  description String
  amount      Float
  currency    String   @default("NGN")
  type        String   @default("general") // sale | purchase | expense | asset_disposal | payroll | etc.
  source      String?  // accounting | import | api | manual
  status      String   @default("posted") // draft | posted | voided
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity             Entity              @relation(fields: [entityId], references: [id])
  taxClassifications TaxClassification[]
  taxLedgerEntries   TaxLedgerEntry[]

  @@index([entityId, date])
}

model Invoice {
  id          String   @id @default(cuid())
  entityId    String
  customerId  String?
  invoiceNo   String
  date        DateTime
  dueDate     DateTime?
  status      String   @default("draft") // draft | issued | paid | voided
  currency    String   @default("NGN")
  subtotal    Float    @default(0)
  taxTotal    Float    @default(0)
  total       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity   Entity       @relation(fields: [entityId], references: [id])
  customer Customer?    @relation(fields: [customerId], references: [id])
  lines    InvoiceLine[]
  payments Payment[]

  @@index([entityId, date])
  @@index([invoiceNo])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  taxRate     Float   @default(0)
  taxAmount   Float   @default(0)
  total       Float   @default(0)
  metadata    Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Bill {
  id        String   @id @default(cuid())
  entityId  String
  vendorId  String?
  billNo    String
  date      DateTime
  dueDate   DateTime?
  status    String   @default("draft") // draft | received | paid | voided
  currency  String   @default("NGN")
  subtotal  Float    @default(0)
  taxTotal  Float    @default(0)
  total     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity   Entity    @relation(fields: [entityId], references: [id])
  vendor   Vendor?   @relation(fields: [vendorId], references: [id])
  lines    BillLine[]
  payments Payment[]

  @@index([entityId, date])
  @@index([billNo])
}

model BillLine {
  id          String  @id @default(cuid())
  billId      String
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  taxRate     Float   @default(0)
  taxAmount   Float   @default(0)
  total       Float   @default(0)
  metadata    Json?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  entityId  String
  invoiceId String?
  billId    String?
  date      DateTime
  amount    Float
  method    String   @default("bank_transfer")
  reference String?
  status    String   @default("completed") // pending | completed | failed
  metadata  Json?
  createdAt DateTime @default(now())

  entity  Entity   @relation(fields: [entityId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  bill    Bill?    @relation(fields: [billId], references: [id])

  @@index([entityId, date])
}

model Vendor {
  id        String   @id @default(cuid())
  entityId  String
  name      String
  type      String   @default("corporate") // corporate | individual
  taxId     String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id])
  bills  Bill[]

  @@index([entityId, name])
}

model Customer {
  id        String   @id @default(cuid())
  entityId  String
  name      String
  taxId     String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  entity   Entity   @relation(fields: [entityId], references: [id])
  invoices Invoice[]

  @@index([entityId, name])
}

model ChartOfAccount {
  id          String   @id @default(cuid())
  entityId    String
  code        String
  name        String
  type        String   @default("expense") // asset | liability | equity | income | expense
  category    String?
  description String?
  createdAt   DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id])

  @@unique([entityId, code])
}

model TaxRuleSet {
  id            String   @id @default(cuid())
  entityId      String
  version       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String   @default("active") // draft | active | retired
  source        String   @default("internal") // internal | external
  createdAt     DateTime @default(now())

  entity        Entity    @relation(fields: [entityId], references: [id])
  rules         TaxRule[]
  schedules     TaxSchedule[]
  ledgerEntries TaxLedgerEntry[]

  @@index([entityId, version])
}

model TaxCategory {
  id          String   @id @default(cuid())
  entityId    String
  name        String
  taxType     String   // VAT | WHT | CIT | CGT | STAMP
  description String?
  createdAt   DateTime @default(now())

  entity          Entity             @relation(fields: [entityId], references: [id])
  rules           TaxRule[]
  classifications TaxClassification[]

  @@index([entityId, taxType])
}

model TaxRule {
  id         String   @id @default(cuid())
  entityId   String
  ruleSetId  String
  categoryId String?
  taxType    String
  name       String
  rate       Float    @default(0)
  rateType   String   @default("percentage") // percentage | fixed
  priority   Int      @default(0)
  conditions Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  entity      Entity       @relation(fields: [entityId], references: [id])
  ruleSet     TaxRuleSet   @relation(fields: [ruleSetId], references: [id])
  category    TaxCategory? @relation(fields: [categoryId], references: [id])
  ledgerLines TaxLedgerEntry[]
  classifications TaxClassification[]

  @@index([ruleSetId, taxType])
}

model TaxClassification {
  id            String   @id @default(cuid())
  entityId      String
  transactionId String
  taxType       String
  categoryId    String?
  ruleId        String?
  confidence    Float    @default(0.6)
  status        String   @default("auto") // auto | manual
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entity      Entity       @relation(fields: [entityId], references: [id])
  transaction Transaction  @relation(fields: [transactionId], references: [id])
  category    TaxCategory? @relation(fields: [categoryId], references: [id])
  rule        TaxRule?     @relation(fields: [ruleId], references: [id])

  @@index([entityId, taxType])
  @@index([transactionId, taxType])
}

model TaxLedgerEntry {
  id            String   @id @default(cuid())
  entityId      String
  transactionId String?
  taxType       String
  ruleSetId     String
  ruleId        String?
  categoryId    String?
  periodId      String?
  baseAmount    Float    @default(0)
  taxAmount     Float    @default(0)
  direction     String   @default("payable") // payable | credit
  ledger        String   @default("output") // output | input | adjustment
  metadata      Json?
  createdAt     DateTime @default(now())

  entity      Entity        @relation(fields: [entityId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  ruleSet     TaxRuleSet    @relation(fields: [ruleSetId], references: [id])
  rule        TaxRule?      @relation(fields: [ruleId], references: [id])
  category    TaxCategory?  @relation(fields: [categoryId], references: [id])
  period      TaxPeriod?    @relation(fields: [periodId], references: [id])

  @@index([entityId, taxType])
  @@index([periodId, taxType])
}

model TaxPeriod {
  id        String   @id @default(cuid())
  entityId  String
  period    String   // 2026-Q1, 2026-01, 2026-FY
  startDate DateTime
  endDate   DateTime
  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity        Entity           @relation(fields: [entityId], references: [id])
  schedules     TaxSchedule[]
  ledgerEntries TaxLedgerEntry[]
  complianceDeadlines ComplianceDeadline[]
  complianceStatuses  ComplianceStatus[]
  taxFilingPackages   TaxFilingPackage[]
  taxPayments         TaxPayment[]
  taxReconciliations  TaxReconciliation[]

  @@index([entityId, period])
}

model TaxSchedule {
  id           String   @id @default(cuid())
  entityId     String
  periodId     String
  ruleSetId    String
  taxType      String
  dueDate      DateTime
  status       String   @default("draft") // draft | review | ready | filed | paid | reconciled
  totalBase    Float    @default(0)
  totalTax     Float    @default(0)
  carryForward Float    @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entity     Entity     @relation(fields: [entityId], references: [id])
  period     TaxPeriod  @relation(fields: [periodId], references: [id])
  ruleSet    TaxRuleSet @relation(fields: [ruleSetId], references: [id])

  @@index([entityId, taxType])
}

model ComplianceDeadline {
  id        String   @id @default(cuid())
  entityId  String
  periodId  String
  taxType   String
  dueDate   DateTime
  status    String   @default("open") // open | overdue | closed
  createdAt DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id])
  period TaxPeriod @relation(fields: [periodId], references: [id])

  @@index([entityId, taxType])
}

model ComplianceStatus {
  id        String   @id @default(cuid())
  entityId  String
  periodId  String
  taxType   String
  stage     String   @default("draft") // draft | review | ready | filed | paid | reconciled
  updatedAt DateTime @updatedAt

  entity Entity    @relation(fields: [entityId], references: [id])
  period TaxPeriod @relation(fields: [periodId], references: [id])

  @@index([entityId, taxType])
}

model TaxFilingPackage {
  id          String   @id @default(cuid())
  entityId    String
  periodId    String
  taxType     String
  format      String   @default("pdf") // pdf | xlsx | csv
  fileUrl     String?
  status      String   @default("generated") // generated | sent | archived
  metadata    Json?
  generatedAt DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id])
  period TaxPeriod @relation(fields: [periodId], references: [id])

  @@index([entityId, taxType])
}

model TaxPayment {
  id        String   @id @default(cuid())
  entityId  String
  periodId  String
  taxType   String
  amount    Float
  paidAt    DateTime?
  method    String   @default("bank_transfer")
  reference String?
  status    String   @default("pending") // pending | paid | failed
  metadata  Json?
  createdAt DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id])
  period TaxPeriod @relation(fields: [periodId], references: [id])

  @@index([entityId, taxType])
}

model TaxReconciliation {
  id        String   @id @default(cuid())
  entityId  String
  periodId  String
  taxType   String
  status    String   @default("open") // open | matched | mismatch
  summary   Json?
  createdAt DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id])
  period TaxPeriod @relation(fields: [periodId], references: [id])

  @@index([entityId, taxType])
}

model AuditLog {
  id           String   @id @default(cuid())
  entityId     String
  actor        String   @default("system")
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId, action])
}
